# Copy to .env, then: set -a && source .env && set +a && mvn spring-boot:run
# (or just run ./run.sh, which does it for you)
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=iot_monitor
DB_USER=root
DB_PASSWORD=123456

# Broker this project actually uses - same host/port/credentials as the
# ESP8266 firmware in ../test/sketch_aug17a/sketch_aug17a.ino.
# When running the firmware on real hardware, set MQTT_BROKER_URL to this
# machine's LAN address so the board can reach it.
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://192.168.0.103:1865
MQTT_USERNAME=toannd135
MQTT_PASSWORD=b23dccn831
MQTT_CLIENT_ID=iot-backend

# Origins allowed to call the API (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_USER_ID=1
PENDING_TIMEOUT=10
